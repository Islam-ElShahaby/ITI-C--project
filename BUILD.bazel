load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# ── Header-Only External Libraries ──────────────────────────────

cc_library(
    name = "magic_enum",
    hdrs = glob(["external_libs/magic_enum/*.hpp"]),
    includes = ["external_libs/magic_enum"],
)

cc_library(
    name = "nlohmann_json",
    hdrs = glob(["external_libs/nlohmann/**/*.hpp"]),
    includes = ["external_libs"],
)

# ── CommonAPI Generated Sources ─────────────────────────────────

cc_library(
    name = "commonapi_gen",
    srcs = [
        "src-gen/v1/omnimetron/gpu/GpuUsageDataSomeIPDeployment.cpp",
        "src-gen/v1/omnimetron/gpu/GpuUsageDataSomeIPProxy.cpp",
        "src-gen/v1/omnimetron/gpu/GpuUsageDataSomeIPStubAdapter.cpp",
    ],
    hdrs = glob(["src-gen/**/*.hpp"]),
    includes = ["src-gen"],
    alwayslink = True,
    deps = [
        "//third_party:commonapi",
        "//third_party:commonapi_someip",
        "//third_party:vsomeip3",
    ],
)

# ── Common Headers ──────────────────────────────────────────────

cc_library(
    name = "project_headers",
    hdrs = glob(["inc/**/*.hpp"]),
    includes = ["inc"],
    visibility = ["//visibility:public"],
)

# ── LoggerBase Static Library ───────────────────────────────────

cc_library(
    name = "logger_base",
    srcs = [
        "src/Application.cpp",
        "src/LogManager.cpp",
        "src/LogMessage.cpp",
        "src/LogSinks.cpp",
        "src/SafeFile.cpp",
        "src/SafeSocket.cpp",
        "src/TelemetrySources.cpp",
        "src/ThreadPool.cpp",
    ],
    deps = [
        ":project_headers",
        ":magic_enum",
        ":nlohmann_json",
        ":commonapi_gen",
        "//third_party:commonapi",
        "//third_party:commonapi_someip",
        "//third_party:vsomeip3",
    ],
)

# ── LoggerApp (Client) Executable ───────────────────────────────

cc_binary(
    name = "LoggerApp",
    srcs = [
        "app/main.cpp",
        "src/SomeIPTelemetrySource.cpp",
    ],
    includes = [
        "src-gen",
    ],
    deps = [
        ":logger_base",
        ":project_headers",
        ":commonapi_gen",
        ":magic_enum",
        ":nlohmann_json",
        "//third_party:commonapi",
        "//third_party:commonapi_someip",
        "//third_party:vsomeip3",
    ],
)

# ── GpuService Executable ──────────────────────────────────────

cc_binary(
    name = "GpuService",
    srcs = [
        "app/service_main.cpp",
        "src/GpuUsageService.cpp",
    ],
    includes = [
        "src-gen",
    ],
    deps = [
        ":project_headers",
        ":commonapi_gen",
        ":magic_enum",
        "//third_party:commonapi",
        "//third_party:commonapi_someip",
        "//third_party:vsomeip3",
    ],
)

# ── Qt App Headers ──────────────────────────────────────────────

cc_library(
    name = "qt_app_headers",
    hdrs = glob(["qt_app/inc/**/*.hpp"]),
    includes = ["qt_app/inc"],
    deps = [
        ":project_headers",
        "//third_party:qt6_widgets",
    ],
)

# ── Qt MOC Code Generation ──────────────────────────────────────
# Bazel has no AUTOMOC, so we run moc manually for each Q_OBJECT header.

_QT_MOC_HEADERS = [
    "qt_app/inc/QtSinkImpl.hpp",
    "qt_app/inc/TelemetryChartWidget.hpp",
    "qt_app/inc/ConfigEditorWidget.hpp",
    "qt_app/inc/LogViewerWidget.hpp",
    "qt_app/inc/MainWindow.hpp",
]

[genrule(
    name = "moc_" + hdr.split("/")[-1].replace(".hpp", ""),
    srcs = [hdr],
    outs = ["moc_" + hdr.split("/")[-1].replace(".hpp", ".cpp")],
    cmd = "/usr/lib/qt6/libexec/moc " +
          "-I$$(pwd)/inc " +
          "-I$$(pwd)/qt_app/inc " +
          "-I/usr/include/x86_64-linux-gnu/qt6 " +
          "-I/usr/include/x86_64-linux-gnu/qt6/QtWidgets " +
          "-I/usr/include/x86_64-linux-gnu/qt6/QtGui " +
          "-I/usr/include/x86_64-linux-gnu/qt6/QtCore " +
          "$(location " + hdr + ") -o $@",
) for hdr in _QT_MOC_HEADERS]

# ── LoggerQtApp (GUI) Executable ────────────────────────────────

cc_binary(
    name = "LoggerQtApp",
    srcs = [
        "qt_app/src/qt_main.cpp",
        "qt_app/src/QtSinkImpl.cpp",
        "qt_app/src/TelemetryChartWidget.cpp",
        "qt_app/src/ConfigEditorWidget.cpp",
        "qt_app/src/LogViewerWidget.cpp",
        "qt_app/src/MainWindow.cpp",
        "src/SomeIPTelemetrySource.cpp",
        # MOC-generated files
        ":moc_QtSinkImpl",
        ":moc_TelemetryChartWidget",
        ":moc_ConfigEditorWidget",
        ":moc_LogViewerWidget",
        ":moc_MainWindow",
    ],
    copts = [
        "-isystem/usr/include/x86_64-linux-gnu/qt6",
        "-isystem/usr/include/x86_64-linux-gnu/qt6/QtWidgets",
        "-isystem/usr/include/x86_64-linux-gnu/qt6/QtGui",
        "-isystem/usr/include/x86_64-linux-gnu/qt6/QtCore",
        "-DQT_WIDGETS_LIB",
        "-DQT_GUI_LIB",
        "-DQT_CORE_LIB",
        "-fPIC",
    ],
    includes = [
        "qt_app/inc",
        "src-gen",
    ],
    deps = [
        ":logger_base",
        ":qt_app_headers",
        ":project_headers",
        ":commonapi_gen",
        ":magic_enum",
        ":nlohmann_json",
        "//third_party:commonapi",
        "//third_party:commonapi_someip",
        "//third_party:vsomeip3",
        "//third_party:qt6_widgets",
    ],
)
