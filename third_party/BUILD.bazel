load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# ── CommonAPI Core ──────────────────────────────────────────────
cc_library(
    name = "commonapi",
    hdrs = glob(["stub_commonapi/**"], allow_empty = True),  # placeholder, headers come from system
    includes = [],
    linkopts = [
        "-L/usr/local/lib",
        "-lCommonAPI",
    ],
    deps = [],
)

# ── CommonAPI SomeIP Binding ────────────────────────────────────
cc_library(
    name = "commonapi_someip",
    linkopts = [
        "-L/usr/local/lib",
        "-lCommonAPI-SomeIP",
    ],
    deps = [":commonapi"],
)

# ── vSOME/IP ────────────────────────────────────────────────────
cc_library(
    name = "vsomeip3",
    linkopts = [
        "-L/usr/local/lib",
        "-lvsomeip3",
    ],
)

# ── Qt6 Widgets (System) ────────────────────────────────────────
cc_library(
    name = "qt6_widgets",
    hdrs = [],
    includes = [],
    copts = [
        "-isystem/usr/include/x86_64-linux-gnu/qt6",
        "-isystem/usr/include/x86_64-linux-gnu/qt6/QtWidgets",
        "-isystem/usr/include/x86_64-linux-gnu/qt6/QtGui",
        "-isystem/usr/include/x86_64-linux-gnu/qt6/QtCore",
        "-DQT_WIDGETS_LIB",
        "-DQT_GUI_LIB",
        "-DQT_CORE_LIB",
        "-fPIC",
    ],
    linkopts = [
        "-lQt6Widgets",
        "-lQt6Gui",
        "-lQt6Core",
    ],
)
